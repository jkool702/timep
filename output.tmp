)"

mapfile -t -d '' b < <(eval "$(sed -E 's/^/echo \$'"'"'\\036'"'"'/' <<<"$a")" | sed -zE 's/\n[ \t'$'\036'']*\n/\x00/g')

printf '%s\n\n\n' "${b[@]}" "${#b[@]}"


a1=$(printf '%s\n\n' "${b[@]//$'\n'/\$"'"\\n"'"}" | (sed -E 's/^([^'$'\036'']+)'$'\036''(.+'"'"')([0-9\.]+ [0-9\.]+ [0-9\.]+ [0-9\.]+ [0-9]+)\\/3\t\2'$'\036''\1%s %s %s %s %s\\/' )
#echo "$a1"

kk=0
until [[ "$a" == "$a1" ]]; do
a="$a1"
a1=$(sed -E 's/^([^'$'\036'']+)'$'\036''(.+'"'"')([0-9\.]+ [0-9\.]+ [0-9\.]+ [0-9\.]+ [0-9]+)\\/3\t\2'$'\036''\1%s %s %s %s %s\\/' <<<"$a")

#echo "$a1"
(( kk>1 )) && break
((kk++))
done
